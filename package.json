{
  "name": "pdn-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Perin Devi Natyalayam — website and student portal monorepo",
  "scripts": {
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "frontend:lint": "cd frontend && npm run lint",
    "frontend:install": "cd frontend && npm install",
    "backend:dev": "cd backend && python manage.py runserver",
    "backend:test": "cd backend && pytest",
    "backend:lint": "cd backend && ruff check .",
    "backend:migrate": "cd backend && python manage.py migrate",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:migrate": "docker compose exec backend python manage.py migrate"
  }
}
